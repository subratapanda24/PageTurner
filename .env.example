PORT=5000
NODE_ENV=development
JWT_SECRET=pageturner_super_secret_jwt_key_2026

# MongoDB Connection String (Leave empty to use built-in MongoDB Memory Server automatically!)
MONGO_URI=mongodb://127.0.0.1:27017/pageturner

# Razorpay Credentials (Optional - Mock mode active if empty)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# Firebase Credentials (Optional - Local disk upload active if empty)
FIREBASE_PROJECT_ID=pageturner-firebase-app
FIREBASE_AUTH_DOMAIN=pageturner-firebase-app.firebaseapp.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@pageturner-firebase-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=pageturner-firebase-app.appspot.com
